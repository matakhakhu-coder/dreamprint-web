# DreamPrint SA — Environment Variables
# Copy this file to .env and fill in confirmed values.
# NEVER commit .env to source control.

# PayFast — server-side only, never exposed to client
PAYFAST_MERCHANT_KEY=

# MailerLite transactional email
VITE_MAILER_LITE_KEY=

# Admin authentication (only needed when adminSimulated: false)
VITE_ADMIN_EMAIL=

# Supabase (Phase 2 — only needed when ordersSimulated: false)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Launch gate — override default domain for sitemap generation
SITE_URL=https://dreamprintsa.co.za
